-- INPUT BOX
local function box(parent,text,val,callback)

	local b = Instance.new("TextBox",parent)
	b.Size = UDim2.new(1,0,0,30)
	b.Text = text.." : "..val
	b.BackgroundColor3 = Color3.new(1,1,1)
	b.TextColor3 = Color3.new(0,0,0)
	b.Font = Enum.Font.Gotham
	b.TextSize = 14
	Instance.new("UICorner",b)

	b.FocusLost:Connect(function()
		local n = tonumber(b.Text)
		if n then
			callback(n)
			b.Text = text.." : "..n
		end
	end)

end

-- TOGGLE
local function toggle(parent,text,callback)

	local t = Instance.new("TextButton",parent)
	t.Size = UDim2.new(1,0,0,30)
	t.Text = text.." : OFF"
	t.BackgroundColor3 = Color3.new(1,1,1)
	t.TextColor3 = Color3.new(0,0,0)
	t.Font = Enum.Font.GothamBold
	t.TextSize = 14
	Instance.new("UICorner",t)

	local on = false

	t.MouseButton1Click:Connect(function()

		on = not on
		t.Text = text.." : "..(on and "ON" or "OFF")
		t.BackgroundColor3 = on and Color3.fromRGB(0,255,120) or Color3.new(1,1,1)

		callback(on)

	end)

end

